{
  "manifest_version": 3,
  "name": "종료할 때 방문 기록 삭제",
  "version": "1.0.0",
  "description": "아이콘을 누르면 로그인 상태를 유지하면서 전체 기간의 사용 기록을 삭제합니다.",
  "permissions": [
    "browsingData",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "방문 기록 삭제 설정",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
